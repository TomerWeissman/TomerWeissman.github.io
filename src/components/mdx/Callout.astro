---
interface Props {
  type?: "note" | "result" | "warning";
  title?: string;
}

const { type = "note", title } = Astro.props;
const defaultTitles = { note: "Note", result: "Result", warning: "Caveat" };
---

<aside class={`callout callout-${type}`}>
  <div class="callout-title">{title ?? defaultTitles[type]}</div>
  <slot />
</aside>
