---
// A strip of headline numbers, e.g. [{ label: "RMSE (mg/dL)", value: "18.2" }]
interface Props {
  items: { label: string; value: string }[];
}

const { items } = Astro.props;
---

<div class="metrics">
  {items.map((item) => (
    <div class="metric">
      <div class="value">{item.value}</div>
      <div class="label">{item.label}</div>
    </div>
  ))}
</div>
